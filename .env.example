# Backend API base URL used by the frontend (Vite reads VITE_* vars).
# For local development point it at the FastAPI dev server:
VITE_API_URL=http://localhost:8000

# Pinata (IPFS) credentials used when minting carbon-credit NFTs.
# Get these from https://app.pinata.cloud/developers/api-keys
VITE_API_PINATA_ENV=
VITE_API_SECRET_ENV=
